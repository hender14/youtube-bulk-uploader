FROM ubuntu:24.04
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 uploader \
    && useradd --uid 10001 --gid 10001 --create-home uploader
COPY --chown=10001:10001 --chmod=755 yt-uploader-rs /usr/local/bin/yt-uploader-rs
USER 10001:10001
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/yt-uploader-rs"]